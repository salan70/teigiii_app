{
  "name": "teigiii-server",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src scripts test worker-test vitest.config.ts",
    "format": "oxfmt src scripts test worker-test vitest.config.ts",
    "format:check": "oxfmt --check src scripts test worker-test vitest.config.ts",
    "test": "bun run test:unit && bun run test:workers",
    "test:unit": "bun test",
    "test:workers": "vitest run --config vitest.config.ts",
    "generate:openapi": "bun run scripts/generate-openapi.ts",
    "generate:migrations": "drizzle-kit generate",
    "dev": "wrangler dev",
    "migration:export": "bun run scripts/migration/export.ts",
    "migration:import": "bun run scripts/migration/import.ts",
    "migration:verify": "bun run scripts/migration/verify.ts"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.5.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.30",
    "jose": "^6.2.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.18.4",
    "@cloudflare/workers-types": "^5.20260714.1",
    "@seriousme/openapi-schema-validator": "^2.9.0",
    "@types/bun": "^1.3.14",
    "drizzle-kit": "^0.31.10",
    "firebase-admin": "^14.2.0",
    "oxfmt": "^0.59.0",
    "oxlint": "^1.74.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.0",
    "wrangler": "^4.110.0"
  }
}
