{
    // 検索対象から除外するファイル
    "search.exclude": {
        "**/.nix": true,
        "**/*.freezed.dart": true,
        "**/*.g.dart": true,
        "**/*.gr.dart": true,
        "**/*.mocks.dart": true,
    },
    // ファイル監視対象から除外するファイル
    "files.watcherExclude": {
        "**/.nix": true
    },
    // ファイルエクスプローラーの表示から除外するファイル
    "files.exclude": {
        "**/*.freezed.dart": true,
        "**/*.g.dart": true,
        "**/*.mocks.dart": true,
    },
    "cSpell.words": [
        "unfollow",
        "unfollower",
        "unfollowing",
        "unmute"
    ],
}
