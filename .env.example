# ローカル専用の設定の例。`.env` にコピーして使う（`.env` は gitignore 済み）。

# 実機へ入れるときの既定の端末（just device-dev）。端末名か UDID。
# 一覧は `xcrun devicectl list devices`。
TEIGIII_DEVICE=My iPhone

# App Check の debug token（UUID、任意）。Firebase の dev に登録済みのものを指定する。
# 実機の起動時に FIRAAppCheckDebugToken として渡す。未指定なら端末ごとに自動生成される。
# APP_CHECK_DEBUG_TOKEN=00000000-0000-0000-0000-000000000000
